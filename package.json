{
  "name": "exotic-tint-qatar",
  "version": "2.0.0",
  "private": true,
  "description": "Exotic Tint Qatar — static bilingual (EN/AR) website",
  "scripts": {
    "images": "node scripts/images.js",
    "html": "node src/build.js",
    "css": "tailwindcss -i src/styles.css -o dist/assets/css/app.css --minify",
    "build": "npm run html && npm run css",
    "dev": "npm run build && node scripts/serve.js",
    "serve": "node scripts/serve.js"
  },
  "devDependencies": {
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  }
}
